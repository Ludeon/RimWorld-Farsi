<LanguageData>
  
  <!-- EN: firefoam pop pack -->
  <Apparel_FirefoampopPack.label>بسته فوم آتش‌نشانی</Apparel_FirefoampopPack.label>
  <!-- EN: A utility pack made for firefighters. When triggered, a burst of fire-retardant foam is released, covering a wide circle around its wearer. -->
  <Apparel_FirefoampopPack.description>یک بسته کاربردی ساخته شده برای آتش‌نشانان. هنگامی که فعال می‌شود، انفجاری از فوم ضد آتش آزاد می‌شود و دایره وسیعی را در اطراف پوشنده آن می‌پوشاند.</Apparel_FirefoampopPack.description>
  <!-- EN: firefoam pop -->
  <Apparel_FirefoampopPack.comps.CompApparelReloadable.chargeNoun>فوم آتش‌نشانی</Apparel_FirefoampopPack.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <Apparel_FirefoampopPack.comps.CompApparelReloadable.cooldownGerund>در حال خنک شدن</Apparel_FirefoampopPack.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: pop firefoam -->
  <Apparel_FirefoampopPack.verbs.pop_firefoam.label>پخش فوم آتش‌نشانی</Apparel_FirefoampopPack.verbs.pop_firefoam.label>
  
  <!-- EN: smokepop pack -->
  <Apparel_SmokepopBelt.label>بسته دودزا</Apparel_SmokepopBelt.label>
  <!-- EN: A defensive smokescreen. When activated, it will release a cloud of smoke, obscuring incoming shots and preventing turrets from locking on. -->
  <Apparel_SmokepopBelt.description>یک پرده دود دفاعی. هنگامی که فعال می‌شود، ابری از دود آزاد می‌کند که دید شلیک‌های ورودی را مسدود کرده و از قفل کردن برجک‌ها جلوگیری می‌کند.</Apparel_SmokepopBelt.description>
  <!-- EN: smokepop -->
  <Apparel_SmokepopBelt.comps.CompApparelReloadable.chargeNoun>دودزا</Apparel_SmokepopBelt.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <Apparel_SmokepopBelt.comps.CompApparelReloadable.cooldownGerund>در حال خنک شدن</Apparel_SmokepopBelt.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: pop smoke -->
  <Apparel_SmokepopBelt.verbs.pop_smoke.label>پخش دود</Apparel_SmokepopBelt.verbs.pop_smoke.label>
  
</LanguageData>