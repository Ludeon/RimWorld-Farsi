<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: medical only -->
  <DrugUse_MedicalOnly.label>فقط پزشکی</DrugUse_MedicalOnly.label>
  <!-- EN: Poisoning the body for recreational purposes is a deeply immoral act. -->
  <DrugUse_MedicalOnly.description>مسموم کردن بدن برای اهداف تفریحی عملی عمیقاً غیراخلاقی است.</DrugUse_MedicalOnly.description>
  <!-- EN: Ingest recreational drug -->
  <DrugUse_MedicalOnly.comps.2.description>مصرف داروی تفریحی</DrugUse_MedicalOnly.comps.2.description>
  <!-- EN: Administer recreational drug -->
  <DrugUse_MedicalOnly.comps.5.description>تجویز داروی تفریحی</DrugUse_MedicalOnly.comps.5.description>
  
  <!-- EN: medical or social only -->
  <DrugUse_MedicalOrSocial.label>فقط پزشکی یا اجتماعی</DrugUse_MedicalOrSocial.label>
  <!-- EN: A drink with a smoke is fine, especially with friends, but poisoning the body with powerful chemicals is wrong. -->
  <DrugUse_MedicalOrSocial.description>نوشیدنی با دود خوب است، به خصوص با دوستان، اما مسموم کردن بدن با مواد شیمیایی قوی اشتباه است.</DrugUse_MedicalOrSocial.description>
  <!-- EN: Ingest hard drug -->
  <DrugUse_MedicalOrSocial.comps.2.description>مصرف مواد مخدر سنگین</DrugUse_MedicalOrSocial.comps.2.description>
  <!-- EN: Administer hard drug -->
  <DrugUse_MedicalOrSocial.comps.5.description>تجویز مواد مخدر سنگین</DrugUse_MedicalOrSocial.comps.5.description>
  
  <!-- EN: prohibited -->
  <DrugUse_Prohibited.label>ممنوع</DrugUse_Prohibited.label>
  <!-- EN: The body should absolutely not be poisoned by chemicals. The only exception is the use of medicine in direct medical care. -->
  <DrugUse_Prohibited.description>بدن مطلقاً نباید توسط مواد شیمیایی مسموم شود. تنها استثنا استفاده از دارو در مراقبت‌های پزشکی مستقیم است.</DrugUse_Prohibited.description>
  <!-- EN: Ingest drug -->
  <DrugUse_Prohibited.comps.0.description>مصرف دارو</DrugUse_Prohibited.comps.0.description>
  <!-- EN: Administer drug -->
  <DrugUse_Prohibited.comps.5.description>تجویز دارو</DrugUse_Prohibited.comps.5.description>
  
</LanguageData>