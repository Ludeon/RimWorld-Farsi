  <!-- EN: spectacular execution -->
  <SpectacularExecution.stages.spectacular_execution.label>اعدام تماشایی</SpectacularExecution.stages.spectacular_execution.label>
  <!-- EN: That execution was electrifying! Never have I felt such a sensation of justice being served. -->
  <SpectacularExecution.stages.spectacular_execution.description>آن اعدام برق‌آسا بود! هرگز چنین احساسی از برقراری عدالت نداشته‌ام.</SpectacularExecution.stages.spectacular_execution.description>
  
  <!-- EN: spectacular sacrifice -->
  <SpectacularSacrifice.stages.spectacular_sacrifice.label>قربانی تماشایی</SpectacularSacrifice.stages.spectacular_sacrifice.label>
  <!-- EN: The blood! The release! That sacrifice made me feel like we were connecting with another world. -->
