<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: artificial metabolism -->
  <ArtificialMetabolism.label>سوخت‌وساز مصنوعی</ArtificialMetabolism.label>
  <!-- EN: Craft bionics that process food more safely or efficiently than a biological stomach. -->
  <ArtificialMetabolism.description>ساخت بیونیک‌هایی که غذا را ایمن‌تر یا کارآمدتر از معده بیولوژیکی هضم می‌کنند.</ArtificialMetabolism.description>
  <!-- EN:
    <li>subject->artificial metabolism</li>
    <li>subject_story->developed a hunger so all-consuming that the installation of an artificial stomach was the only solution</li>
    <li>subject_story->did not tell the Queen about the installation of the sterilizing stomach, but continued as her food tester all the same</li>
    <li>subject_story->developed a loathing for food. A nuclear stomach heavily reduced food consumption, though the radioactivity was a nuisance</li>
    <li>subject_gerund->crafting digestion-related bionics</li>
    <li>subject_gerund->crafting artificial guts</li>
  -->
  <ArtificialMetabolism.generalRules.rulesStrings>
    <li>subject->سوخت‌وساز مصنوعی</li>
    <li>subject_story->گرسنگی بی‌پایانی را تجربه کرد به طوری که نصب معده مصنوعی تنها راه‌حل بود</li>
    <li>subject_gerund->ساخت بیونیک‌های گوارشی</li>
  </ArtificialMetabolism.generalRules.rulesStrings>
  
  <!-- EN: brain wiring -->
  <BrainWiring.label>سیم‌کشی مغز</BrainWiring.label>
  <!-- EN: Craft brain implants that induce or prevent blunt sensations like joy or pain. -->
  <BrainWiring.description>ساخت ایمپلنت‌های مغزی که احساساتی چون لذت یا درد را ایجاد یا مسدود می‌کنند.</BrainWiring.description>
  <!-- EN:
    <li>subject->brain implants</li>
    <li>subject_story->wrote a paper about the masochist cults use of mindscrews to improve their morale</li>
    <li>subject_story->implanted painstoppers in an assault squad. They eliminated a much larger force, but were all mortally wounded or killed</li>
    <li>subject_story->had a joywire installed and, though happy after that, stumbled simply through life</li>
    <li>subject_gerund->crafting brain implants</li>
  -->
  <BrainWiring.generalRules.rulesStrings>
    <li>subject->ایمپلنت‌های مغزی</li>
    <li>subject_gerund->ساخت ایمپلنت‌های مغزی</li>
  </BrainWiring.generalRules.rulesStrings>
  
  <!-- EN: circadian influence -->
  <CircadianInfluence.label>تأثیر سیرکادین (چرخه خواب)</CircadianInfluence.label>
  <!-- EN: Craft brain implants that chemically manipulate the circadian rhythm, reducing or altering the need to sleep. -->
  <CircadianInfluence.description>ساخت ایمپلنت‌های مغزی که ریتم شبانه‌روزی را از طریق شیمیایی دستکاری کرده و نیاز به خواب را کاهش داده یا دگرگون می‌سازند.</CircadianInfluence.description>
  <!-- EN:
    <li>subject->sleep reduction implant</li>
    <li>subject_story->studied unihemispheric sleep patterns in cetaceans and proposed a new form of circadian half-cycler</li>
    <li>subject_story->forced any applicants for city guard to receive a half-cycler, so they could stay at post indefinitely, if necessary</li>
    <li>subject_story->studied bullfrogs and giraffes to ascertain what  xenogerms would be necessary for a circadian assistance gland</li>
    <li>subject_gerund->crafting sleep reduction implants</li>
  -->
  <CircadianInfluence.generalRules.rulesStrings>
    <li>subject->ایمپلنت کاهش خواب</li>
    <li>subject_gerund->ساخت ایمپلنت‌های کاهش خواب</li>
  </CircadianInfluence.generalRules.rulesStrings>
  
  <!-- EN: compact weaponry -->
  <CompactWeaponry.label>تسلیحات فشرده</CompactWeaponry.label>
  <!-- EN: Craft compact, concealable bionic weapons which can be embedded in various body parts. -->
  <CompactWeaponry.description>ساخت سلاح‌های بیونیک فشرده و پنهان‌شونده که می‌توان در بخش‌های مختلف بدن جاسازی کرد.</CompactWeaponry.description>
  <!-- EN:
    <li>subject->compact weaponry</li>
    <li>subject_story->was employed as a detective and was saved more than once by the concealed knee spike</li>
    <li>subject_story->spent a summer recovering from being slashed by an escaped slave's hand talon</li>
    <li>subject_story->was working in security, scanning visitors to the hall, when the cyborg attempted to enter</li>
    <li>subject_gerund->crafting compact bionic weapons</li>
  -->
  <CompactWeaponry.generalRules.rulesStrings>
    <li>subject->تسلیحات فشرده</li>
    <li>subject_gerund->ساخت سلاح‌های بیونیک فشرده</li>
  </CompactWeaponry.generalRules.rulesStrings>
  
  <!-- EN: flesh shaping -->
  <FleshShaping.label>شکل‌دهی گوشت (زیبایی‌پزشکی)</FleshShaping.label>
  <!-- EN: Craft bionics which induce the reshaping of natural flesh, usually for the purposes of aesthetic enhancement or personal pleasure. -->
  <FleshShaping.description>ساخت بیونیک‌هایی که شکل‌دهی گوشت طبیعی را ممکن می‌سازند، معمولاً با اهداف زیبایی یا لذت شخصی.</FleshShaping.description>
  <!-- EN:
    <li>subject->aesthetic surgery</li>
    <li>subject_story->halted the population decline on the urbworld, by distributing free love enhancers and lavish drugs</li>
    <li>subject_story->was hired as chief flesh-shaper for an aesthetics clinic, spending [ANYPAWN_possessive] days making shapely limbs</li>
    <li>subject_story->gathered the glitterworld children around the campfire and told horror stories about getting their non-aesthetic noses back</li>
    <li>subject_gerund->crafting aesthetic bionics</li>
  -->
  <FleshShaping.generalRules.rulesStrings>
    <li>subject->جراحی زیبایی</li>
    <li>subject_gerund->ساخت بیونیک‌های زیبایی</li>
  </FleshShaping.generalRules.rulesStrings>
  
  <!-- EN: healing factors -->
  <HealingFactors.label>فاکتورهای ترمیمی</HealingFactors.label>
  <!-- EN: Craft bionics that enhance natural healing processes. -->
  <HealingFactors.description>ساخت بیونیک‌هایی که روندهای التیام و ترمیم طبیعی بدن را تقویت می‌کنند.</HealingFactors.description>
  <!-- EN:
    <li>subject->healing bionics</li>
    <li>subject_story->studied the Imperial royalty, to see if they had blue blood. They did not, but it did coagulate implausibly quickly</li>
    <li>subject_story->ensured that all the pit fighters had Healing Enhancers and appropriate xenogerms, so that they could fight more often</li>
    <li>subject_story->studied the ancient corpses found in a cryptosleep shrine and harvested rapid healing devices from them</li>
    <li>subject_gerund->crafting regeneration bionics</li>
  -->
  <HealingFactors.generalRules.rulesStrings>
    <li>subject->بیونیک‌های ترمیمی</li>
    <li>subject_gerund->ساخت بیونیک‌های باززایی</li>
  </HealingFactors.generalRules.rulesStrings>
  
  <!-- EN: molecular analysis -->
  <MolecularAnalysis.label>تحلیل مولکولی</MolecularAnalysis.label>
  <!-- EN: Craft bionics with molecular analyzers for assisting the immune system or analyzing food. -->
  <MolecularAnalysis.description>ساخت بیونیک‌های مجهز به تحلیل‌کننده‌های مولکولی برای پشتیبانی از سیستم ایمنی یا تحلیل مواد غذایی.</MolecularAnalysis.description>
  <!-- EN:
    <li>subject->molecular analysis bionics</li>
    <li>subject_story->explained to the chefs of the cooking school that they must never get aesthetic noses, lest their gastro-analyzers fail</li>
    <li>subject_story->had an immunoenhancer installed and so was able to walk freely in the isolation colony</li>
    <li>subject_story->lectured on the potential hardware conflicts between bionic parts and molecular analysis implants</li>
    <li>subject_gerund->crafting molecular analysis bionics</li>
  -->
  <MolecularAnalysis.generalRules.rulesStrings>
    <li>subject->بیونیک‌های تحلیل مولکولی</li>
    <li>subject_gerund->ساخت بیونیک‌های تحلیل مولکولی</li>
  </MolecularAnalysis.generalRules.rulesStrings>
  
  <!-- EN: neural computation -->
  <NeuralComputation.label>محاسبات عصبی</NeuralComputation.label>
  <!-- EN: Craft brain implants that assist thought and learning by use of a direct, shallow brain-computer interface. -->
  <NeuralComputation.description>ساخت ایمپلنت‌های مغزی که از طریق رابط مغز-کامپیوتر به تفکر و یادگیری کمک می‌کنند.</NeuralComputation.description>
  <!-- EN:
    <li>subject->brain implants</li>
    <li>subject->neural computation</li>
    <li>subject_story->knew exactly how to take out the jailor, with an EMP attack that would brain shock their learning assistant, buying time to free the prisoners</li>
    <li>subject_story->mandated the installation of learning assistants or neurocalculators through the entire faculty</li>
    <li>subject_story->had a learning assistant installed. It proved to be a problem later, when captured by pirates, who halted any escape attempts with EMP attacks</li>
    <li>subject_gerund->crafting brain implants</li>
  -->
  <NeuralComputation.generalRules.rulesStrings>
    <li>subject->ایمپلنت‌های مغزی</li>
    <li>subject->محاسبات عصبی</li>
    <li>subject_gerund->ساخت ایمپلنت‌های مغزی</li>
  </NeuralComputation.generalRules.rulesStrings>
  
  <!-- EN: skin hardening -->
  <SkinHardening.label>سخت‌سازی پوست</SkinHardening.label>
  <!-- EN: Craft bionic implants which induce the toughening of natural skin, producing an armor-like effect. -->
  <SkinHardening.description>ساخت ایمپلنت‌های بیونیک که موجب سفت و سخت شدن پوست طبیعی شده و اثری زره‌مانند پدید می‌آورند.</SkinHardening.description>
  <!-- EN:
    <li>subject->subdermal implants</li>
    <li>subject_story->researched the glands of the barkskin dryads and reasoned they could be adapted to humanity</li>
    <li>subject_story->traveled among the stoneskin tamers of the dinoworld, studying the thick keratin plates that covered them</li>
    <li>subject_story->worked with nanonmachine glands to thicken the human epidermis, at the expense of meeting traditional standards of beauty</li>
    <li>subject_gerund->crafting subdermal armor implants</li>
  -->
  <SkinHardening.generalRules.rulesStrings>
    <li>subject->ایمپلنت‌های زیرپوستی</li>
    <li>subject_gerund->ساخت ایمپلنت‌های زره زیرپوستی</li>
  </SkinHardening.generalRules.rulesStrings>
  
  <!-- EN: specialized limbs -->
  <SpecializedLimbs.label>اندام‌های تخصصی</SpecializedLimbs.label>
  <!-- EN: Craft specialized bionic limbs built for specific purposes - both combat and labor. -->
  <SpecializedLimbs.description>ساخت اندام‌های بیونیک تخصصی برای اهداف ویژه - چه در نبرد و چه در کار و تولید.</SpecializedLimbs.description>
  <!-- EN:
    <li>subject->specialized prosthetics</li>
    <li>subject_story->interviewed the indentured farmers of a feudal world, before and after their field hand installations</li>
    <li>subject_story->watched a pit fighter equipped with a power claw face off against a miner with two drill arms</li>
    <li>subject_story->worked as a surgeon on the rim, replacing missing arms with everything from a woodhand to a power claw</li>
    <li>subject_gerund->crafting specialized bionic arms</li>
  -->
  <SpecializedLimbs.generalRules.rulesStrings>
    <li>subject->پروتزهای تخصصی</li>
    <li>subject_gerund->ساخت بازوهای بیونیک تخصصی</li>
  </SpecializedLimbs.generalRules.rulesStrings>
  
  <!-- EN: poison synthesis -->
  <VenomSynthesis.label>سنتز سم</VenomSynthesis.label>
  <!-- EN: Craft bionics that synthesize venom from internal chemical reactors for use in toxifying attacks. -->
  <VenomSynthesis.description>ساخت بیونیک‌هایی که با رآکتورهای شیمیایی داخلی سم تولید می‌کنند تا در حملات مسموم‌کننده به کار گرفته شوند.</VenomSynthesis.description>
  <!-- EN:
    <li>subject->venomous bionics</li>
    <li>subject_story->worked on chemical reactors at small scales, which could be shrunk and stored internally</li>
    <li>subject_story->studied the waste rats of a trash world and wrote a paper on the unique toxins in their bite</li>
    <li>subject_story->learned to love sharp little cutting edges, which could kill with a mere nick</li>
    <li>subject_gerund->crafting poisonous bionic weapons</li>
  -->
  <VenomSynthesis.generalRules.rulesStrings>
    <li>subject->بیونیک‌های سمی</li>
    <li>subject_gerund->ساخت سلاح‌های بیونیک سمی</li>
  </VenomSynthesis.generalRules.rulesStrings>
  
</LanguageData>