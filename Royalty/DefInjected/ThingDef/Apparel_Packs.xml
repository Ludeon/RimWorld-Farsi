  <Apparel_PackJump.comps.CompApparelReloadable.cooldownGerund>در خنک شدن</Apparel_PackJump.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: jump -->
  <Apparel_PackJump.verbs.jump.label>پرش</Apparel_PackJump.verbs.jump.label>
  
