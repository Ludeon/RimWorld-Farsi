<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: attended concert -->
  <AttendedConcert.label>در کنسرت شرکت کرد</AttendedConcert.label>
  <!-- EN:
    <li>tale_noun->[ATTENDER_nameDef] attending [ORGANIZER_nameDef]'s concert</li>
    <li>tale_noun->[ATTENDER_nameDef] listening to [ORGANIZER_nameDef]'s performance</li>
    <li>image->[ATTENDER_nameFull] listening quietly, [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] enjoying [ORGANIZER_nameFull]'s performance [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] swaying to the music [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] absorbed in the sound [circumstance_group]</li>
    <li>circumstance_phrase->while clapping</li>
    <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s dance along.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal]s listen attentively.</li>
  -->
  <AttendedConcert.rulePack.rulesStrings>
    <li>tale_noun->[ATTENDER_nameDef] در کنسرت [ORGANIZER_nameDef] شرکت می‌کند</li>
    <li>tale_noun->[ATTENDER_nameDef] در حال گوش دادن به عملکرد [ORGANIZER_nameDef]</li>
    <li>image->[ATTENDER_nameFull] بی سر و صدا گوش می‌دهد، [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] از عملکرد [ORGANIZER_nameFull] [circumstance_group] لذت می‌برد</li>
    <li>image->[ATTENDER_nameFull] در حال نوسان به موسیقی [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] در صدای [circumstance_group] جذب می‌شود</li>
    <li>circumstance_phrase->هنگام کف زدن</li>
    <li>desc_sentence->[Quantity_adjphrase] [PersonJob] با هم می‌رقصند.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal] با دقت گوش می‌دهند.</li>
  </AttendedConcert.rulePack.rulesStrings>
  
  <!-- EN: held concert -->
  <HeldConcert.label>کنسرت برگزار کرد</HeldConcert.label>
  <!-- EN:
    <li>tale_noun->[ORGANIZER_nameDef] performing a concert</li>
    <li>image->[ORGANIZER_nameFull] playing their signature song [circumstance_group]</li>
    <li>image->[ORGANIZER_nameFull] inviting the crowd to sing along</li>
    <li>image->[ORGANIZER_nameFull] playing an inspiring song</li>
    <li>image->[ORGANIZER_nameFull] performing a difficult piece [circumstance_group]</li>
    <li>circumstance_phrase->with an intense expression</li>
    <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s listen nearby.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal]s listen nearby.</li>
  -->
  <HeldConcert.rulePack.rulesStrings>
    <li>tale_noun->[ORGANIZER_nameDef] در حال اجرای کنسرت</li>
    <li>image->[ORGANIZER_nameFull] در حال پخش آهنگ امضای خود [circumstance_group]</li>
    <li>image->[ORGANIZER_nameFull] جمعیت را به آواز خواندن دعوت می‌کند</li>
    <li>image->[ORGANIZER_nameFull] در حال پخش یک آهنگ الهام بخش</li>
    <li>image->[ORGANIZER_nameFull] در حال اجرای یک قطعه دشوار [circumstance_group]</li>
    <li>circumstance_phrase->با یک عبارت شدید</li>
    <li>desc_sentence->[Quantity_adjphrase] [PersonJob] در همین نزدیکی گوش می‌دهند.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal] در این نزدیکی گوش می‌دهند.</li>
  </HeldConcert.rulePack.rulesStrings>
  
</LanguageData>