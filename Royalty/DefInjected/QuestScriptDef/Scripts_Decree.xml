<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must build a monument. It is [monumentSize] in size and will require these resources (total value [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\n[decreeThreatInfo]\n\nYou must keep the monument safe for [keepMonumentTicks_duration] after completion, otherwise [asker_nameDef] will be unhappy.</li>
  -->
  <Decree_BuildMonument.questDescriptionRules.rulesStrings>
    <li>questDescription->[decreeIntro]\n\nشما باید یک بنای تاریخی بسازید. اندازه آن [monumentSize] است و به این منابع نیاز دارد (مقدار کلی [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\n[decreeThreatInfo]\n\nبعد از تکمیل باید بنای یادبود را برای [keepMonumentTicks_duration] ایمن نگه دارید، در غیر این صورت [asker_nameDef] ناراضی خواهد بود.</li>
  </Decree_BuildMonument.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->monument decree</li>
  -->
  <Decree_BuildMonument.questNameRules.rulesStrings>
    <li>questName->فرمان یادبود</li>
  </Decree_BuildMonument.questNameRules.rulesStrings>
  <!-- EN: New monument marker arrived -->
  <Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>نشانگر یادبود جدید رسید</Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>
  <!-- EN: Since the monument marker has been destroyed, a new one has been sent. -->
  <Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>از آنجایی که نشانگر بنای تاریخی تخریب شده است، یک نشانگر جدید ارسال شده است.</Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>
  <!-- EN: Monument completed -->
  <Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>بنای یادبود تکمیل شد</Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>
  <!-- EN: You have completed construction of the monument.\n\nYou must keep it safe for [keepMonumentTicks_duration], otherwise [asker_nameDef] will be displeased. -->
  <Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>شما ساخت بنای تاریخی را به پایان رسانده اید.\n\nشما باید آن را برای [keepMonumentTicks_duration] ایمن نگه دارید، در غیر این صورت [asker_nameDef] ناراضی خواهد شد.</Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>
  <!-- EN: Monument destroyed -->
  <Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>بنای تاریخی تخریب شد</Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>
  <!-- EN: [asker_nameDef] is offended that you allowed the monument to be ruined so soon after completion.\n\n[asker_pronoun] will be unhappy about this. -->
  <Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>[asker_nameDef] از اینکه اجازه دادید بنای یادبود به این زودی پس از اتمام خراب شود، آزرده خاطر است.\n\n[asker_pronoun] از این بابت ناراضی خواهد بود.</Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>بنای یادبود را برای {0} تخریب نکنید</Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>بنای یادبود را برای {0} تخریب نکنید</Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>
  <!-- EN: Keep monument {0} -->
  <Decree_BuildMonument.KeepMonument.slateRef>بنای یادبود {0} را نگه دارید</Decree_BuildMonument.KeepMonument.slateRef>
  
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must harvest [plantToHarvest_label] x[harvestItemCount].\n\nYou may need to plant and grow the [plantToHarvest_label] first.\n\n[decreeThreatInfo]</li>
  -->
  <Decree_HarvestCrop.questDescriptionRules.rulesStrings>
    <li>questDescription->[decreeIntro]\n\nشما باید [plantToHarvest_label] x[harvestItemCount] را برداشت کنید.\n\nممکن است ابتدا نیاز به کاشت و رشد [plantToHarvest_label] داشته باشید.\n\n[decreeThreatInfo]</li>
  </Decree_HarvestCrop.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[plantToHarvest_label] harvest decree</li>
  -->
  <Decree_HarvestCrop.questNameRules.rulesStrings>
    <li>questName->حکم برداشت [plantToHarvest_label]</li>
  </Decree_HarvestCrop.questNameRules.rulesStrings>
  
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must hunt or slaughter [animalToHuntWithCount].\n\n[decreeThreatInfo]</li>
    <li>animalToHuntWithCount(countToHunt==1)->[animalToHunt_indefinite]</li>
    <li>animalToHuntWithCount(countToHunt!=1)->[countToHunt] [animalToHunt_labelPlural]</li>
  -->
  <Decree_HuntAnimal.questDescriptionRules.rulesStrings>
    <li>questDescription->[decreeIntro]\n\nشما باید [animalToHuntWithCount] را شکار یا ذبح کنید.\n\n[decreeThreatInfo]</li>
    <li>animalToHuntWithCount(countToHunt==1)->[animalToHunt_indefinite]</li>
    <li>animalToHuntWithCount(countToHunt!=1)->[countToHunt] [animalToHunt_labelPlural]</li>
  </Decree_HuntAnimal.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[animalToHunt_label] hunting decree</li>
  -->
  <Decree_HuntAnimal.questNameRules.rulesStrings>
    <li>questName->حکم شکار [animalToHunt_label]</li>
  </Decree_HuntAnimal.questNameRules.rulesStrings>
  
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must produce:\n\n - [thingToProduceLabel]\n\n[decreeThreatInfo]</li>
  -->
  <Decree_ProduceItem.questDescriptionRules.rulesStrings>
    <li>questDescription->[decreeIntro]\n\nشما باید تولید کنید:\n\n - [thingToProduceLabel]\n\n[decreeThreatInfo]</li>
  </Decree_ProduceItem.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[defToProduce_label] production decree</li>
  -->
  <Decree_ProduceItem.questNameRules.rulesStrings>
    <li>questName->فرمان تولید [defToProduce_label]</li>
  </Decree_ProduceItem.questNameRules.rulesStrings>
  
</LanguageData>