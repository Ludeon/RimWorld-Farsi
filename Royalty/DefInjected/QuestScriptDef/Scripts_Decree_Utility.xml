<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>decreeIntro->[asker_nameDef], your [asker_bestRoyalTitle], has issued a royal decree.</li>
    <li>decreeThreatInfo->If you fail to fulfill this decree within [decreeDays] days, [asker_nameDef] will start to become unhappy. [asker_possessive] anger will increase over time until the decree is satisfied.</li>
  -->
  <DecreeSetup.questDescriptionRules.rulesStrings>
    <li>decreeIntro->[asker_nameDef]، [asker_bestRoyalTitle] شما، حکم سلطنتی صادر کرده است.</li>
    <li>decreeThreatInfo->اگر در طی روزهای [decreeDays] موفق به اجرای این حکم نشدید، [asker_nameDef] شروع به ناراضی شدن خواهد کرد. خشم [asker_possessive] به مرور زمان افزایش می‌یابد تا این که فرمان راضی شود.</li>
  </DecreeSetup.questDescriptionRules.rulesStrings>
  <!-- EN: [asker_nameDef]'s decree forgotten -->
  <DecreeSetup.LetterLabelDecreeForgotten.slateRef>فرمان [asker_nameDef] فراموش شد</DecreeSetup.LetterLabelDecreeForgotten.slateRef>
  <!-- EN: [asker_nameDef] has forgotten about [asker_possessive] decree. -->
  <DecreeSetup.LetterTextDecreeForgotten.slateRef>[asker_nameDef] فرمان [asker_possessive] را فراموش کرده است.</DecreeSetup.LetterTextDecreeForgotten.slateRef>
  <!-- EN: Decree cancelled -->
  <DecreeSetup.LetterLabelDecreeCancelled.slateRef>حکم لغو شد</DecreeSetup.LetterLabelDecreeCancelled.slateRef>
  <!-- EN: [asker_nameDef] has grudgingly cancelled the decree '[resolvedQuestName]' since it cannot be completed. -->
  <DecreeSetup.LetterTextDecreeCancelled.slateRef>[asker_nameDef] با اکراه فرمان "[resolvedQuestName]" را لغو کرده است زیرا نمی‌تواند تکمیل شود.</DecreeSetup.LetterTextDecreeCancelled.slateRef>
  
</LanguageData>