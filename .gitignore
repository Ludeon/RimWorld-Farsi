# --- Game files (RimWorld Root) ---
# Ignore executables and huge binary folders at the root
/*.exe
/*.dll
/RimWorldWin64_Data/
/MonoBleedingEdge/
/Source/

# --- The Data Folder Strategy ---
# 1. Ignore EVERYTHING inside Data (Core, Royalty, Biotech, etc.)
/Data/*

# 2. Exception: Un-ignore ONLY the Persian language folders in any DLC/Core
# The * matches "Core", "Royalty", etc.
!/Data/*/Languages/Persian/

# --- Modding & Tools ---
# Ignore all other mods users might drop in
/mods/*
/othermoderstools/*

# Exception: Your specific mod source/content
!/mods/RTL_Persian_Support/

# Ensure your custom tools are always tracked
!/tools/

