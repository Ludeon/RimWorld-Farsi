  <!-- EN: witnessed death with bloodlust -->
  <WitnessedDeathBloodlust.stages.witnessed_death_with_bloodlust.label>شاهد مرگ با خونخواهی بود</WitnessedDeathBloodlust.stages.witnessed_death_with_bloodlust.label>
  <!-- EN: I saw someone die! That was intense! -->
