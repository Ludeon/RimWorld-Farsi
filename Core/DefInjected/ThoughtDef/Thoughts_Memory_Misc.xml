  <!-- EN: defeated hostile leader -->
  <DefeatedHostileFactionLeaderOpinion.stages.defeated_hostile_leader.label>رهبر متخاصم را شکست داد</DefeatedHostileFactionLeaderOpinion.stages.defeated_hostile_leader.label>
  
  <!-- EN: defeated insect hive -->
  <DefeatedInsectHive.stages.defeated_insect_hive.label>کندوی حشره شکست خورده</DefeatedInsectHive.stages.defeated_insect_hive.label>
