  <!-- EN: defeated hostile leader {0} -->
  <DefeatedHostileFactionLeader.stages.defeated_hostile_leader.label>رهبر متخاصم {0} را شکست داد</DefeatedHostileFactionLeader.stages.defeated_hostile_leader.label>
