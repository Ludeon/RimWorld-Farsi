  <!-- EN: prisoner banished to death -->
  <PrisonerBanishedToDie.stages.prisoner_banished_to_death.label>زندانی تا مرگ تبعید شد</PrisonerBanishedToDie.stages.prisoner_banished_to_death.label>
  <!-- EN: We banished a prisoner in such a way that there's almost no way they'll survive. -->
